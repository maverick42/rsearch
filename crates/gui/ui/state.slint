// Shared UI state and data shapes for the rsearch window.
//
// `TrStrings` carries every user-visible label: the Rust side fills it
// from the active `tr::Strings` table, so switching language only
// means writing this struct again — this file never changes.
// `AppState` is the single bridge between widgets and the Rust
// application: widgets read its properties and call its callbacks, the
// Rust controller owns the catalog, the engine handles and all logic.

/// All user-visible static text. Dynamic messages (notices, banners,
/// result headers) are formatted in Rust and arrive as plain
/// properties — only labels, hints and section titles live here.
export struct TrStrings {
    app-title: string,
    nav-search: string,
    nav-projects: string,
    nav-preferences: string,
    save: string,
    cancel: string,
    delete: string,
    rename: string,
    retry: string,
    yes: string,
    no: string,
    browse: string,
    edit: string,
    open-projects: string,
    dismiss: string,
    projects: string,
    new-project: string,
    no-projects-hint: string,
    select-project-hint: string,
    status-never-built: string,
    settings-section: string,
    source-roots: string,
    root-recursive: string,
    root-top-level-only: string,
    excluded-dirs: string,
    include-masks: string,
    exclude-masks: string,
    respect-gitignore: string,
    max-indexed-file-size: string,
    fallback-encoding: string,
    fallback-none: string,
    index-archives: string,
    archive-max-depth: string,
    cancel-build: string,
    last-build: string,
    name: string,
    project-name-hint: string,
    add-root: string,
    remove-root: string,
    root-path-hint: string,
    excluded-dirs-hint: string,
    masks-hint: string,
    delete-project-title: string,
    delete-warning: string,
    catalog-unavailable: string,
    search-project-label: string,
    search-field-hint: string,
    search-button: string,
    options-section: string,
    opt-case-sensitive: string,
    opt-whole-word: string,
    opt-analyze-oversized: string,
    opt-context-lines: string,
    results-section: string,
    /// Accessible name of a file row's copy button.
    copy-path: string,
    /// Accessible name of a file row's remove button — drops the
    /// file group from the displayed list only.
    remove-result: string,
    /// Accessible names of the results-header buttons.
    expand-all: string,
    collapse-all: string,
    export-results: string,
    /// Results view toolbar: filter field, ✕ button, sort combo and
    /// the descending checkbox.
    results-filter-placeholder: string,
    results-filter-clear: string,
    results-filter-label: string,
    results-sort-label: string,
    results-desc-label: string,
    saved-searches: string,
    saved-name-hint: string,
    load: string,
    save-search-title: string,
    duplicate: string,
    new-tab: string,
    close-tab: string,
    rename-tab-title: string,
    tab-name-hint: string,
    reset-tab-name: string,
    prefs-language: string,
    prefs-theme: string,
    prefs-defaults-section: string,
    prefs-default-excluded-dirs: string,
    prefs-default-include-masks: string,
    prefs-default-exclude-masks: string,
    prefs-default-max-size: string,
    prefs-defaults-note: string,
    prefs-updates-section: string,
    prefs-check-updates: string,
    prefs-check-now: string,
    /// Hint under the disabled update-check checkbox.
    prefs-check-updates-soon: string,
    prefs-autosave-note: string,
    viewer-loading: string,
    viewer-truncated: string,
    /// Viewer toolbar: open the displayed file with its Windows
    /// file association.
    viewer-open-external: string,
    /// Viewer toolbar: copy the lines currently visible on screen.
    viewer-copy-visible: string,
    /// Title of the Projects-screen build-report section.
    build-report-section: string,
    /// Shown next to the project picker when archive indexing is
    /// disabled (D15).
    archives-excluded: string,
    /// Deletion is refused while a search tab still uses the project.
    project-in-use: string,
}

/// One label/value line of a details grid (project settings, build
/// summary, live build counters).
export struct KvRow {
    label: string,
    value: string,
}

/// One entry of the project list.
export struct ProjectRow {
    id: string,
    name: string,
    /// 0 = never built, 1 = rebuild needed, 2 = up to date.
    status-kind: int,
    status-text: string,
    /// Secondary line: index file date (local timezone) and size.
    detail: string,
    selected: bool,
}

/// One banner line above the content area.
export struct BannerRow {
    /// 0 info, 1 success, 2 warning, 3 error.
    level: int,
    text: string,
    action-label: string,
    has-action: bool,
    dismissible: bool,
    /// Index into the app's notice list (-1 when not dismissible).
    notice-idx: int,
    /// Reports ongoing work (pulsing marker).
    working: bool,
}

/// One text run of a rendered line — plain, or a query match (`hit`).
export struct SegRow {
    text: string,
    hit: bool,
    /// The focused occurrence — viewer rows only; always false in the
    /// result list.
    current: bool,
}

/// One wrapped visual line of an occurrence row: a horizontal run of
/// segments. A long source line stacks several pieces vertically.
export struct PieceRow {
    segs: [SegRow],
}

/// One row of the flattened, virtualized result list.
export struct ResultRow {
    /// 0 = file group header, 1 = occurrence, 2 = context line.
    kind: int,
    /// Header rows: the full label. Occurrence rows: the "line:col"
    /// prefix — their line text lives in `pieces`.
    text: string,
    /// Occurrence rows only: the line split at query matches, wrapped
    /// into pieces that fit the list's width (empty for headers and
    /// context lines).
    pieces: [PieceRow],
    /// Header rows only: the undecorated file path copied by the
    /// row's copy button — `text` holds the decorated label.
    path: string,
    /// File index inside the report (-1 meaningless for headers only).
    file-idx: int,
    /// Occurrence index inside the file (-1 for headers).
    occ-idx: int,
    selected: bool,
    /// File group expanded (header rows only).
    open: bool,
}

/// One numbered line of the internal file viewer.
export struct ViewerRow {
    /// 1-indexed source line number.
    num: int,
    /// The line's text split at query matches (`hit` segments get a
    /// yellow marker).
    segs: [SegRow],
    /// The focused match line — drawn with an accent background.
    current: bool,
}

/// One source-root row of the project editor.
export struct RootRow {
    path: string,
    recursive: bool,
}

/// One search tab of the Search screen.
export struct TabRow {
    /// Automatic or custom title, already truncated for display.
    title: string,
    /// This tab is the visible one.
    active: bool,
    /// A search job is running in this tab.
    working: bool,
    /// The tab is associated with a saved search — shown as a small
    /// floppy-disk icon left of the title.
    saved: bool,
}

/// The application bridge: every dynamic value the widgets display and
/// every action they can request. Callbacks are implemented in Rust.
export global AppState {
    /// Active text table — replaced wholesale on language change.
    in-out property <TrStrings> tr;
    /// `rsearch` crate version, shown in the sidebar.
    in property <string> app-version;

    /// 0 = Search, 1 = Projects, 2 = Preferences.
    in-out property <int> screen;
    /// Left-nav selection — the app tracks the screen for banners.
    callback navigate(int);

    // -- Catalog -----------------------------------------------------
    in property <bool> catalog-ok;
    in property <string> catalog-error;
    callback retry-catalog();

    // -- Projects ----------------------------------------------------
    in property <[ProjectRow]> projects;
    /// Project names for the search picker, same order as `projects`.
    in property <[string]> project-names;
    /// The project selected in the Projects screen list — the editing
    /// and building selection. Search tabs keep their own project
    /// (`search-project-index`); the two never sync.
    callback select-project(int);
    callback new-project();
    callback edit-project();
    callback ask-delete-project();
    callback start-build();
    callback cancel-build();

    // -- Selected project detail --------------------------------------
    in property <bool> has-selection;
    in property <string> sel-name;
    in property <int> sel-status;
    in property <string> sel-status-text;
    /// Archive indexing is disabled for the selected project (D15):
    /// archive contents are outside the candidate set.
    in property <bool> sel-archives-excluded;
    /// "Build index" or "Update index" depending on history.
    in property <string> build-action-label;
    /// Any build is in flight — actions stay disabled meanwhile.
    in property <bool> build-busy;
    /// The running build targets the selected project.
    in property <bool> sel-building;
    in property <string> build-phase;
    in property <[KvRow]> build-counters;
    in property <[KvRow]> settings-rows;
    in property <[KvRow]> summary-rows;
    in property <bool> has-summary;
    in-out property <bool> settings-open;
    in-out property <bool> summary-open;
    /// Report of the last finished build of this project: file-error
    /// details and skipped source roots.
    in property <bool> has-build-report;
    in-out property <bool> build-report-open;
    in property <[KvRow]> build-report-rows;

    // -- Search tabs ----------------------------------------------------
    /// One row per open search tab; the first is always there.
    in property <[TabRow]> tabs;
    callback activate-tab(int);
    callback close-tab(int);
    callback new-tab();
    /// Opens the rename dialog for a tab (double-click on its title).
    callback ask-rename-tab(int);

    // -- Search form ---------------------------------------------------
    /// Index of the active tab's project in `project-names`, -1 for
    /// none — each search tab keeps its own selection, independent of
    /// the Projects screen's.
    in-out property <int> search-project-index;
    callback select-search-project(int);
    /// The active tab has a project picked — drives the
    /// saved-searches strip.
    in property <bool> search-has-project;
    /// Status of the active tab's project, shown beside the picker.
    in property <int> search-status;
    in property <string> search-status-text;
    /// Archive indexing is disabled for the active tab's project
    /// (D15): archive contents are outside the candidate set.
    in property <bool> search-archives-excluded;
    in-out property <string> query;
    /// The query reaches the engine minimum length.
    in property <bool> query-valid;
    /// Non-empty query below the minimum — drives the hint.
    in property <bool> query-too-short;
    in property <string> query-hint;
    in property <bool> searching;
    in property <bool> can-search;
    in-out property <bool> options-open;
    in-out property <bool> opt-case;
    in-out property <bool> opt-word;
    in-out property <bool> opt-oversized;
    /// Context lines (slider value, 0..16).
    in-out property <float> opt-context;
    /// File-name masks (`;`/newline separated, `*`/`?` wildcards on
    /// file names). Empty include list searches everything.
    in-out property <string> opt-include-masks;
    in-out property <string> opt-exclude-masks;
    /// Fired on every edit so `query-valid`/`can-search` stay fresh.
    callback query-changed();
    callback run-search();
    callback cancel-search();

    // -- Saved searches --------------------------------------------------
    /// Row 0 is the localized placeholder; real names start at 1.
    in property <[string]> saved-names;
    /// Index of the saved search selected in the bottom combo — 0 is
    /// the placeholder row ("no selection").
    in-out property <int> saved-index;
    /// The combo selection moved — only records which saved search
    /// Load/Delete acts on; it never touches the search form.
    callback select-saved(int);
    /// Loads the selected saved search: activates the tab already
    /// associated with its id, or fills a NEW tab — never overwrites
    /// the current tab, never starts a search.
    callback load-saved();
    /// Opens the save dialog — its name field starts on the
    /// associated entry's name (Save then updates it) or on the tab
    /// title (Save then creates a new entry).
    callback ask-save-search();
    callback ask-delete-saved();

    // -- Results ------------------------------------------------------------
    in property <[ResultRow]> results;
    /// A finished or in-flight search is on screen.
    in property <bool> has-results;
    /// 'Results · "query" · N matches in M files · provenance'.
    in property <string> results-title;
    /// Skipped counters / cancellation / deep-scan progress, one line.
    in property <string> results-notes;
    /// The report exists but holds zero verified files.
    in property <bool> results-empty;
    in property <string> results-empty-text;
    callback toggle-result-file(int);
    /// Removes a file group from the displayed rows — visual only:
    /// the report, the counters and the index are untouched.
    callback remove-result-file(int);
    callback select-occurrence(int, int);
    /// Clicked a red match inside an occurrence row.
    callback open-viewer(int, int);
    /// Results-header buttons: expand / collapse every file group.
    callback expand-all-results();
    callback collapse-all-results();
    /// Fills `results-export` with the whole report's
    /// `path:line:col: text` lines — the caller then copies it.
    callback export-results();
    /// Payload produced by `export-results`.
    in property <string> results-export;
    /// The list reports its visible width and its measured monospace
    /// char advance — occurrence lines are then cut to fit so the
    /// list never needs horizontal scrolling.
    callback results-resized(float, float);
    /// Toggled when occurrence rows re-wrap (viewport width changed):
    /// the screen swaps its two `ResultsList` instances so the shown
    /// one is freshly created — a recreated ListView is the only
    /// reliable way to drop its internal scroll anchor.
    in property <bool> results-redraw;

    // -- Results view toolbar -------------------------------------------------
    /// Filter text (raw mask text, "" = no filter). A refused mask
    /// keeps the previous view, silently.
    in-out property <string> results-filter;
    /// Localized sort names, in `SortKey::ALL` order, and the combo's
    /// current index.
    in property <[string]> results-sort-names;
    in-out property <int> results-sort;
    in-out property <bool> results-desc;
    /// Any control change reapplies the view to the active tab.
    callback results-filter-changed();
    callback results-clear-filter();
    callback results-sort-changed(int);
    callback results-desc-changed(bool);

    // -- Internal file viewer ------------------------------------------------
    in property <bool> viewer-open;
    in property <string> viewer-title;
    /// The loader thread is still reading the file.
    in property <bool> viewer-loading;
    in property <string> viewer-error;
    /// The file was too large; only its head is shown.
    in property <bool> viewer-truncated;
    /// 1-indexed line scrolled into view when a file opens.
    in property <int> viewer-focus-line;
    /// Estimated px width of the widest viewer row — the horizontal
    /// scrollable range (long lines scroll).
    in property <float> viewer-content-px;
    /// Estimated px position of the focused match's center — the
    /// horizontal scroll target so a match is never off-screen.
    in property <float> viewer-focus-px;
    /// Parity flip bumped on every prev/next: the viewer swaps
    /// between two list instances so the freshly created one scrolls
    /// to the new match through its own first-layout bindings.
    in property <bool> viewer-nav-flip;
    /// "3/12" — position of the focused match among the file's
    /// matches; empty while loading or on error.
    in property <string> viewer-match-label;
    /// Prev/next buttons — enabled once the file holds more than
    /// one match.
    in property <bool> viewer-nav-enabled;
    in property <[ViewerRow]> viewer-lines;
    callback close-viewer();
    /// -1 previous match, +1 next match — wraps around.
    callback viewer-navigate(int);
    /// Double-click on a viewer line: the word targeted at `x` px
    /// inside segment `seg` of line `line` (whose text renders `w` px
    /// wide) becomes the next query. Hit segments (the current
    /// query's matches) are ignored by the app.
    callback viewer-word-search(int, int, length, length);
    /// Opens the file currently displayed with its Windows file
    /// association — Windows picks the application.
    callback viewer-open-external();
    /// Copies the lines currently on screen: the caller passes the
    /// first visible row index and the row count (rows are 18px tall),
    /// the handler fills `viewer-copy-text` — the caller then copies it.
    callback viewer-copy-visible(int, int);
    /// Payload produced by `viewer-copy-visible`.
    in property <string> viewer-copy-text;
    /// The active viewer list reports the first visible row and the
    /// on-screen row count for the copy button.
    in-out property <int> viewer-copy-first;
    in-out property <int> viewer-copy-count;

    // -- Banners --------------------------------------------------------------
    in property <[BannerRow]> banners;
    callback banner-action(int);
    callback banner-dismiss(int);

    // -- Dialogs -----------------------------------------------------------------
    /// 0 = none, 1 = project editor, 2 = name field, 3 = confirm,
    /// 4 = build confirmation.
    in property <int> dialog-kind;
    in property <string> dialog-title;
    in property <string> dialog-message;
    in property <string> dialog-warning;
    in property <string> dialog-confirm-label;
    in-out property <string> dialog-name;
    /// Placeholder of the name field — per dialog kind.
    in property <string> dialog-name-hint;
    /// The open name dialog offers an "automatic name" reset (tab
    /// rename on a tab with a custom title).
    in property <bool> dialog-can-reset;
    /// The open save dialog offers a Dupliquer button (the tab is
    /// associated with a saved search).
    in property <bool> dialog-can-duplicate;
    /// The name dialog's confirm button — enabled once a name exists.
    out property <bool> dialog-name-filled: dialog-name != "";
    callback dialog-confirm();
    callback dialog-cancel();
    /// Resets the renamed tab to its automatic title.
    callback dialog-reset-name();
    /// The save dialog's Dupliquer button — inserts a copy.
    callback dialog-duplicate();

    // -- Project editor (dialog-kind == 1) ----------------------------------------
    in-out property <string> ed-name;
    in-out property <[RootRow]> ed-roots;
    in-out property <string> ed-excluded-dirs;
    in-out property <string> ed-include-masks;
    in-out property <string> ed-exclude-masks;
    in-out property <bool> ed-gitignore;
    in-out property <string> ed-max-size;
    /// Index into `tr.fallback-none` / "Windows-1252" — the combo of
    /// the project editor dialog.
    in-out property <int> ed-fallback;
    in-out property <bool> ed-archives;
    in-out property <float> ed-archive-depth;
    in property <string> ed-error;
    callback ed-root-path-edited(int, string);
    callback ed-root-recursive-toggled(int, bool);
    callback ed-browse-root(int);
    callback ed-remove-root(int);
    callback ed-add-root();
    callback ed-submit();

    // -- Preferences ------------------------------------------------------------------
    in property <[string]> language-names;
    in property <[string]> theme-names;
    in-out property <int> pref-language;
    in-out property <int> pref-theme;
    callback language-selected(int);
    callback theme-selected(int);
    in-out property <string> pref-dirs;
    in-out property <string> pref-include-masks;
    in-out property <string> pref-exclude-masks;
    in-out property <string> pref-max-size;
    /// Inline error under the max-size field (empty = no error);
    /// derived from the field text at sync time.
    in property <string> pref-error;
    in-out property <bool> pref-check-updates;
    in-out property <bool> pref-defaults-open;
    /// Fired after each edit of the autosaved fields; the prop already
    /// holds the new text.
    callback pref-dirs-edited();
    callback pref-include-masks-edited();
    callback pref-exclude-masks-edited();
    callback pref-max-size-edited();
    callback pref-check-toggled();
    callback check-updates();
}
